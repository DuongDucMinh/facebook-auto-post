# RealPost AI — Biến môi trường

# ===== SUPABASE =====
# Lấy từ Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ===== GROQ AI API =====
# Primary Model: openai/gpt-oss-120b
# Fallback Models (tự động luân chuyển khi chạm limit): openai/gpt-oss-20b, openai/gpt-oss-safeguard-20b, qwen/qwen3.8-27b
# Limits: 30 RPM | 1K RPD | 8K TPM | 200K TPD
# Lấy API key tại: https://console.groq.com/keys
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# ===== THÔNG TIN MÔI GIỚI (Mặc định) =====
VITE_AGENT_NAME=An Nhiên
VITE_AGENT_PHONE=0123456789
VITE_AGENT_PHONE_2=
